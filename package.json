{
  "private": true,
  "name": "@vistta/codehub",
  "version": "0.1.0",
  "description": "Vistta Code Hub — self-hosted code-server IDE with a desktop host app and paired mobile/desktop clients",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "install-runtime": "node scripts/install-runtime.js",
    "start": "vistta ./server.js",
    "server": "vistta ./server.js --dev --watch",
    "pair": "vistta ./scripts/pair.js",
    "cert": "vistta ./scripts/make-cert.js",
    "import": "node scripts/import.js",
    "test": "vistta test \"tests/*.test.js\" --environment=node",
    "dev": "node scripts/dev.js",
    "client:android": "vistta run ./client android --setup=./client/setup.js --out=build/client-android --dev",
    "stage": "node scripts/stage.js",
    "build:windows": "npm run stage && vistta build ./app windows --setup=./app/setup.js --build=build/app --out=dist --name=vistta-code-hub --target=nsis",
    "build:linux": "npm run stage && vistta build ./app linux --setup=./app/setup.js --build=build/app --out=dist --name=vistta-code-hub --target=deb,appimage",
    "build:android": "vistta build ./client android --setup=./client/setup.js --build=build/client-android --out=dist --name=vistta-code-hub-client --target=apk"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/codehub.git"
  },
  "author": "Tiago Terrenas Almeida",
  "license": "MIT",
  "dependencies": {
    "@peculiar/x509": "^1.12.3",
    "@vistta/cli": "^1.2.3",
    "@vistta/fs": "^1.1.0",
    "@vistta/js": "^0.0.1",
    "@vistta/js-native": "^0.0.1",
    "@vistta/ui": "^0.0.1",
    "@vistta/utils": "^1.1.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2"
  }
}